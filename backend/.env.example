# Define your specific exact deployed frontend URL here so that CORS allows the traffic.
# Use the exact domain (e.g. https://exam.yourdomain.com) with no trailing slash.
FRONTEND_URL=https://exam.yourdomain.com

# Define the exact public domain of this API backend (e.g., https://api.yourdomain.com).
# This is required so the Make.com webhook can construct valid image download links.
API_PUBLIC_URL=https://api.yourdomain.com
